<Window x:Class="TypeInVoice.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Type in Voice Settings"
        Width="560" Height="520"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FC"
        FontFamily="Segoe UI">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Type in Voice" FontSize="28" FontWeight="SemiBold" Foreground="#171923" />
            <TextBlock Text="Speak naturally. Your words appear where you were typing."
                       Margin="0,6,0,0" FontSize="14" Foreground="#667085" />
        </StackPanel>

        <Border Grid.Row="2" Background="White" CornerRadius="14" Padding="22" BorderBrush="#E4E7EC" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="OpenAI API key" FontWeight="SemiBold" Foreground="#344054" />
                <PasswordBox x:Name="ApiKeyBox" Margin="0,8,0,0" Padding="10" FontFamily="Consolas" />
                <TextBlock Text="Encrypted for your Windows account and stored only on this PC."
                           Margin="0,6,0,0" FontSize="12" Foreground="#667085" />

                <TextBlock Text="Language" Margin="0,22,0,0" FontWeight="SemiBold" Foreground="#344054" />
                <ComboBox x:Name="LanguageBox" Margin="0,8,0,0" Padding="8" SelectedIndex="0">
                    <ComboBoxItem Content="Auto detect" Tag="auto" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="中文（Chinese）" Tag="zh" />
                    <ComboBoxItem Content="日本語（Japanese）" Tag="ja" />
                    <ComboBoxItem Content="한국어 (Korean)" Tag="ko" />
                    <ComboBoxItem Content="Español (Spanish)" Tag="es" />
                    <ComboBoxItem Content="Français (French)" Tag="fr" />
                    <ComboBoxItem Content="Deutsch (German)" Tag="de" />
                </ComboBox>

                <Border Margin="0,22,0,0" Background="#F2F4F7" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Foreground="#344054" />
                        <TextBlock Margin="0,8,0,0" Foreground="#475467">
                            <Run Text="Ctrl + Alt + D" FontFamily="Consolas" FontWeight="Bold" />
                            <Run Text="  Start, stop, or cancel dictation" />
                        </TextBlock>
                        <TextBlock Margin="0,5,0,0" Foreground="#475467">
                            <Run Text="Ctrl + Alt + S" FontFamily="Consolas" FontWeight="Bold" />
                            <Run Text="  Open settings" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="Save settings" Padding="18,9" Click="SaveButton_Click"
                            Background="#2563EB" Foreground="White" BorderThickness="0" />
                    <Button x:Name="ToggleButton" Content="Start dictation" Padding="18,9" Margin="10,0,0,0"
                            Click="ToggleButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="#EEF4FF" CornerRadius="10" Padding="12">
            <TextBlock x:Name="StatusText" Text="Ready — press Ctrl + Alt + D"
                       Foreground="#3538CD" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
